//+------------------------------------------------------------------+
//|                                                                  |
//+------------------------------------------------------------------+
void OnTick()
{
    MqlTradeResult result;

    MqlDateTime mqlTime;
    TimeCurrent(mqlTime);
    int currentHour = mqlTime.hour;
    int currentMinute = mqlTime.min;
    int currentDay = mqlTime.day;
    string commment_open, comment_order_stat, comment_bb_bands, comment_stop_loss;

    MqlTick lastTick;
    SymbolInfoTick(Symbol(), lastTick);

    MqlRates rates[];

    PositionSelectByTicket(ticketID);

    if(CopyRates(_Symbol, PERIOD_CURRENT, 0, rates_total, rates) > 0)
    {
        double lastBidOfPenultimateCandle = rates[1].close;
        // Agora você pode usar lastBidOfPenultimateCandle
    }

    int copy1 = CopyBuffer(handleEma, 4, 0, rates_total, upperBand);
    int copy2 = CopyBuffer(handleEma, 6, 0, rates_total, lowerBand);
    ArraySetAsSeries(upperBand, true);
    ArraySetAsSeries(lowerBand, true);

    Comment("UpperBandValue: ", upperBand[0], "\n", "LowerBandValue: ", lowerBand[0], "\n", " Ask: ", lastTick.ask);

// New tick
    datetime currentBarTime = iTime(_Symbol, _Period, 0);

    if (currentDay != previousDay)
    {
        profit_day = 0.0;
        previousDay = currentDay;
        consecutiveStopLossCount = 0;
    }

// Trailing Stop between 16:02 and 17:30
    if(iTrallingStopEnable && (currentHour > 16 || (currentHour == 16 && currentMinute > 2)) && currentHour <= 17 && isPositionOpen)
    {
        PositionSelectByTicket(ticketID);  // Select the current open position
        double profit = PositionGetDouble(POSITION_PROFIT);
        double openPrice = PositionGetDouble(POSITION_PRICE_OPEN);
        double stopLossPrice = PositionGetDouble(POSITION_SL);
        double currentPrice = (currentPositionType == POSITION_TYPE_BUY) ? lastTick.ask : lastTick.bid;

        // Check if profit is greater than 0 and if price has moved more than 200 points in favor
        if (profit > 0 && MathAbs(currentPrice - openPrice) > iTrallingStopAmount * _Point)
        {
            // Set new Stop Loss level at 200 points from current price
            if (currentPositionType == POSITION_TYPE_BUY)
            {
                stopLossPrice = currentPrice - iTrallingStopAmount * _Point;
                // Make sure the new stop loss level is higher than the previous level
                if (stopLossPrice > PositionGetDouble(POSITION_SL))
                {
                    trade.PositionModify(ticketID, stopLossPrice, PositionGetDouble(POSITION_TP));
                }
            }
            else // POSITION_TYPE_SELL
            {
                stopLossPrice = currentPrice + iTrallingStopAmount * _Point;
                // Make sure the new stop loss level is lower than the previous level
                if (stopLossPrice < PositionGetDouble(POSITION_SL))
                {
                    trade.PositionModify(ticketID, stopLossPrice, PositionGetDouble(POSITION_TP));
                }
            }
        }
    }

// Checking if price of SELL Order crosses the upper band
    if (isPositionOpen && currentPositionType != POSITION_TYPE_SELL && (rates[0].high >= upperBand[]))
        MakeOrderClose(POSITION_TYPE_BUY);

// Checking if price of BUY Order crosses the upper band
    if (isPositionOpen && currentPositionType != POSITION_TYPE_BUY && (rates[0].low <= lowerBand[2]))
        MakeOrderClose(POSITION_TYPE_SELL);
// Trailing

    if(currentBarTime != lastBarTime)
    {
        // CopyBuffer(handleEma, 0, 0, rates_total, middleBand);
        // CopyBuffer(handleStd, 0, 0, rates_total, stdBuffer);
        // ArraySetAsSeries(stdBuffer, true);
        // ArraySetAsSeries(middleBand, true);
        // ArraySetAsSeries(rates, true);
        // //ArraySetAsSeries(upperBand, true);
        // //ArraySetAsSeries(lowerBand, true);


        // for(int i = 0; i < rates_total; i++)
        // {
        //     upperBand[i] = middleBand[i] + InpBandsDeviation * stdBuffer[i];
        //     lowerBand[i] = middleBand[i] - InpBandsDeviation * stdBuffer[i];
        // }



// Comment
        string order_type = currentPositionType == POSITION_TYPE_BUY ? "BUY" : " SELL";

        comment_bb_bands = "Price Bid: " + DoubleToString(lastTick.bid, 2) + " Price Ask: " + DoubleToString(lastTick.ask, 2) + "\n" +
                           // "\nRates[0] =>" + DoubleToString(rates[0].high , 0) + " - Upper Band: " + DoubleToString(upperBand[0], 2) +
                           // "\nRates[1] =>" + DoubleToString(rates[1].high) + " - Lower Band: " + DoubleToString(lowerBand[0], 2) + "\n" +
                           "\nCross Above: " + ToUpper(string(!isPositionOpen && (rates[0].high >= upperBand[0] || rates[1].high >= upperBand[1]))) +
                           "\nCross Below: " + ToUpper(string(!isPositionOpen && (rates[0].low <= lowerBand[0] || rates[1].low <= lowerBand[1]))) + "\n"
                           ;
        if(isPositionOpen)
            commment_open = "\nOrder Ticket: " + IntegerToString(ticketID) + "\nOrder Type " + order_type + "\nOrder Profit $: " + DoubleToString(PositionGetDouble(POSITION_PROFIT), 2) + "\n";
        else
            commment_open = "";

        comment_order_stat = "\n\nProfit Total: " + DoubleToString(profit_total, 2) + "\nProfit Day: " + DoubleToString(profit_day, 2) + "\n";
        comment_stop_loss = "\nStop Loss Count: " + IntegerToString(consecutiveStopLossCount) + "\nLast Position Hit Stop Loss: " + ToUpper(string(lastPositionHitStopLoss)) + "\n";

        string comment_step_1 = comment_bb_bands + commment_open + comment_stop_loss + comment_order_stat;
        Comment(comment_step_1);
// Comment


        //if(rates[0].high >= upperBand[0])
        //    Comment("Here");
        //if(rates[0].close <= lowerBand[0])
        //    Comment("Here");

        //if(barCount >= iReachBarTimes && reachBar < iReachBarTimes){
        //  reachBar = 0;
        //  barCount = 0;
        //}
        // New bar has formed
        // Place your code for new bar here
        // Remember the current bar time
        upCrossedCandle = false;
        lowCrossedCandle = false;
        barCount += 1;

        lastBarTime = currentBarTime;

// Stop Loss Reach the prie order
        if(isPositionOpen && FindCloseOrderByTicketId(ticketID) > 0)
        {
            //lastPositionHitStopLoss = true;
            long deal_ticket = FindCloseOrderByTicketId(ticketID, iOpenTime);

            double profit = HistoryDealGetDouble(deal_ticket, DEAL_PROFIT);
            if(deal_ticket > 0)
            {
                profit_day   += profit;
                profit_total += profit;

                consecutiveStopLossCount++;
                isPositionOpen  = false;  // Set the position as closed
                iOpenTime       = NULL;

                if(consecutiveStopLossCount == iConsecutiveStopLossMax && lastPositionHitStopLoss)
                    lastPositionHitStopLoss = false;
                else
                    lastPositionHitStopLoss = true;
            }


        }





// Consecutive StopLoss Profit Restrict
        if(iConsecutiveStopLossCountEnable && consecutiveStopLossCount >= iConsecutiveStopLossMax)
        {
            string comment_stop_loss_count = "\nYour are reach your Consecutive Stop Loss Max :" + IntegerToString(consecutiveStopLossCount);
            Comment(comment_step_1 + comment_stop_loss_count);
            return;
        }

// Daily Profit Restrict
        if (profit_day >= iDailyProfit && iDailyProfitAllow)
        {
            string comment_profit_day = "\nYour are reach your Daily Profit " + DoubleToString(iDailyProfit, 2) + " > " + DoubleToString(profit_day, 2);
            Comment(comment_step_1 + comment_profit_day);
            return;  // Exit the function
        }

// Restrict of Date Times to execute orders
        if(!isPositionOpen)
        {
            if(currentHour < 9 || (currentHour == 9 && currentMinute <= 2) || currentHour > 16 || (currentHour == 16 && currentMinute > 1))
                return;
        }

        bool crossAbove = !isPositionOpen && (rates[2].high >= upperBand[2]);
        bool crossBelow = !isPositionOpen && (rates[2].low <= lowerBand[2]);
        // bool crossAbove = !isPositionOpen && (rates[1].high >= upperBand[1] && rates[2].high >= upperBand[2])
        // bool crossBelow = !isPositionOpen && (rates[1].low <= lowerBand[1] && rates[2].low <= lowerBand[2])

        // New Order - Checking if the price hits the Upper band

        // Only set reachBar[ArraySize(reachBar) - 1] = true if crossBelow condition is met and the candle hasn't been crossed before.

        // Later in your code...
        if(!isPositionOpen)
        {
            handleCross(crossAbove, upCrossedCandle, POSITION_TYPE_SELL);
            handleCross(crossBelow, lowCrossedCandle, POSITION_TYPE_BUY);
        }

    }
}
//+------------------------------------------------------------------+
//|                                                |
//+------------------------------------------------------------------+
void handleCross(bool crossCondition, bool &crossedCandle, ENUM_POSITION_TYPE orderType)
{
    if (crossCondition && !crossedCandle)
    {
        reachBar += 1;
        crossedCandle = true;  // We mark that this candle has been crossed.

        //if(reachBar == iReachBarTimes){
        if(MakeOrderOpen(orderType))
        {
            reachBar = 0;
            barCount = 0;
        }
        //}

    }
}

