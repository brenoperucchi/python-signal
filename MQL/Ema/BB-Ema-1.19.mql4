{
//ArraySetAsSeries(middleBand, true);
//ArraySetAsSeries(upperBand, true);
//ArraySetAsSeries(lowerBand, true);
//ArraySetAsSeries(stdBuffer, true);
    ArrayResize(upperBand, rates_total);
    ArrayResize(lowerBand, rates_total);
//ArrayResize(reachBar, iReachBarTimes);



// handleEma = iMA(Symbol(), PERIOD_CURRENT, InpBandsPeriod, 0, MODE_EMA, PRICE_CLOSE);
// handleStd = iStdDev(Symbol(), PERIOD_CURRENT, InpBandsPeriod, 0, MODE_EMA, PRICE_CLOSE);
