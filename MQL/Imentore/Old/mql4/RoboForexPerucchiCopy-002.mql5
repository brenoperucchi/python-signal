class OrderContainer
  {
public:
   int               ticket;
   int               copiedFrom;
   string            symbol;
   int               type;
   double            price;
   double            lot;
   double            stoploss;
   double            takeprofit;
   datetime          opentime;
   string            comment;

                     OrderContainer(void);
                    ~OrderContainer(void)
     {
     }

                     OrderContainer(int pticket,
                  string psymbol,
                  int ptype,
                  double pprice,
                  double plot,
                  double pstoploss,
                  double ptakeprofit,
                  datetime popentime,
                  string pcomment)
     {
      ticket = pticket;
      symbol = psymbol;
      type=ptype;
      price=pprice;
      lot=plot;
      stoploss=pstoploss;
      takeprofit=takeprofit;
      opentime= popentime;
      comment = pcomment;

      if(StringSubstr(pcomment,0,StringLen(prefix))==prefix)
        {
         copiedFrom=StringToInteger(StringSubstr(pcomment,StringLen(prefix)));
        }
     }
  };




